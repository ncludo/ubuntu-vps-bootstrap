# ubuntu-vps-bootstrap configuration
#
# Copy this file to bootstrap.local.conf for local/private overrides.
# bootstrap.local.conf is intentionally excluded from Git.

TIMEZONE="UTC"

SWAP_MODE="auto"
SWAP_SIZE=""

AUTO_REBOOT=false
AUTO_REBOOT_TIME="05:30"

REBOOT_AFTER_BOOTSTRAP=false

JOURNAL_MAX_USE="200M"
JOURNAL_MAX_RETENTION="14day"

ALLOW_TCP_PORTS=()
ALLOW_UDP_PORTS=()

# Optional packages installed in addition to the fixed project BASE_PACKAGES.
#
# This is intentionally empty in the public project defaults.
#
# Example:
# EXTRA_PACKAGES=(
#     tcpdump
#     strace
# )
EXTRA_PACKAGES=()

# Opt-in on an IPv4-accessible VPS with IPv6 disabled and X11 required.
# Default false leaves all SSHD settings unmanaged.
SSHD_X11_IPV4=false
# On this VPS only, in ignored bootstrap.local.conf:
# SSHD_X11_IPV4=true
# EXTRA_PACKAGES+=(xauth xclip)
