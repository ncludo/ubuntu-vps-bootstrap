# Normalize text files
* text=auto eol=lf

# Shell scripts must always use LF
*.sh text eol=lf

# Common text/config files
*.md text eol=lf
*.conf text eol=lf
*.example text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Windows-specific scripts, if ever added
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
